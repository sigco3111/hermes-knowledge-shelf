{
  "name": "hermes-knowledge-shelf",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run privacy-check && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/visual.spec.ts",
    "test:visual": "playwright test",
    "test:e2e": "playwright test",
    "privacy-check": "tsx scripts/privacy-check.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@react-three/drei": "10.7.4",
    "@react-three/fiber": "9.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.179.1",
    "zod": "4.1.5",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "5.0.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
